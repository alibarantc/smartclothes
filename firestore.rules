rules_version = '2';

// Firestore Security Rules — SmartClothes
//
// Current state: ALL reads and writes are DENIED by default.
//
// These rules will be progressively opened up once Firebase Authentication is
// in place (Commit #05). Future rules will follow the pattern:
//
//   match /users/{userId}/{document=**} {
//     allow read, write: if request.auth != null && request.auth.uid == userId;
//   }
//
// To deploy these rules:
//   firebase deploy --only firestore:rules
//
// See docs/firebase-setup.md for the full setup guide.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

